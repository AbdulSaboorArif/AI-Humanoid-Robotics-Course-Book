{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@site/*": ["./*"],
      "lib": ["DOM", "ESNext"]
    },
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "exclude": [".docusaurus", "build"]
}
